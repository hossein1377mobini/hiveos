# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
frontend/.npm-cache/

# Playwright: traces, screenshots and videos from failed e2e runs. The specs and
# the config are committed; only the artifacts are not.
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# Env / secrets — ADR-022: هیچ secret در گیت
.env
.env.*
!.env.example

# Backups (US-1610) — never in git
backups/
deploy/_build.log
deploy/_wheels/

# Exported int8 ONNX models (~2.6GB). Built by
# backend/scripts/export_onnx_models.py and bind-mounted at /opt/models on the
# server — never committed, never baked into an image.
#
# Anchored to the repository root on purpose. The bare pattern 'models/' matches
# at every depth, so it also swallowed backend/backend/models/agent.py: that file
# was present on disk, so the suite passed locally, and absent from git, so CI
# died on "No module named 'backend.models.agent'". Matching only the top-level
# export directory is what the comment above always intended.
/models/

# DSH plugin memory
.dsh-project-memory/
.shots/
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
Thumbs.db
.DS_Store

# Runtime data (ADR-022/US-216): uploaded files never enter git
backend/storage/
# Scratch outputs from test runs
backend/_*.txt

desktop/node_modules/
desktop/dist/

# The Electron wrapper's build inputs, mirroring the frontend rules above.
desktop/out/
desktop/.vite/

# Graph (re)generation output and probe scratch: tooling by-products, not sources.
graphify-out/
frontend/_*.txt
frontend/_probe*.cjs
_probe.js
_*.txt

# Generated test corpus (scripts/make_test_corpus.py) and live-suite output.
# The corpus is ~48 MB of binary fixtures rebuilt on demand, not source.
scripts/corpus/
reports/

