# HiveOS backend example environment (copy to .env and adjust as needed).
# Matches backend/app/config.py (pydantic-settings, env-first).
# NO REAL SECRETS HERE — this is a dev placeholder only.

# App
APP_NAME=HiveOS API
APP_VERSION=0.2.0

# Database (HiveOS is a separate Postgres instance from Kaneo: host port 5434).
DATABASE_URL=postgresql+asyncpg://hiveos:hiveos@localhost:5434/hiveos

# Redis (host port 6380 — not 6379, to avoid conflicts).
REDIS_URL=redis://localhost:6380/0

# Lean startup: create tables on boot (replaced by Alembic when migrations land).
CREATE_TABLES_ON_STARTUP=true

# Encryption key for stored AI provider apiKey. CHANGE THIS for any real use.
SECRET_KEY=dev-insecure-change-me

# OTP
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# CORS origins (JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
