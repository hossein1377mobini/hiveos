# HiveOS backend env (copy to .env for local dev). ADR-022: no secrets committed.
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://hiveos:hiveos@localhost:5434/hiveos
# CORS: comma-separated origins; empty = deny all browser origins. "*" dev only (review R2-2).
CORS_ORIGINS=http://localhost:5173
# SMS/OTP (US-003, ADR-016 amendment 2026-09-08): "mock" logs the 4-digit code
# to the backend console; "melipayamak" sends a real SMS via the console OTP
# service and needs the service id below (secret - never commit).
# SMS_PROVIDER=mock
# MELIPAYAMAK_OTP_SERVICE_ID=<service id from the Melipayamak console>
