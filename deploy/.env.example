# HiveOS v0.1 staging env - copy to .env and fill before compose up.
# Everything else the PO sets in the ADMIN PANEL (/admin), not here.

# PostgreSQL password for the hiveos superuser (required)
HIVEOS_PG_PASSWORD=change-me-strong

# System admin panel credentials (required - used at /admin)
HIVEOS_SYSTEM_ADMIN_USERNAME=system-admin
HIVEOS_SYSTEM_ADMIN_PASSWORD=change-me-strong

# HTTP port nginx binds on the host
HIVEOS_HTTP_PORT=80

# Bootstrap provider mode (the panel decision overrides this at runtime)
HIVEOS_LLM_PROVIDER=mock
HIVEOS_SMS_PROVIDER=mock

# Welcome credit for new organizations
HIVEOS_WALLET_WELCOME_CREDIT=50

# NB-1 (final review): trusted reverse proxies for per-IP rate limiting.
# Comma-separated IPs/CIDRs, or "*" for the single-hop staging topology where
# nginx is the only proxy and the api container is not publicly exposed.
HIVEOS_TRUSTED_PROXIES=*
