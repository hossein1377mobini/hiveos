# HiveOS v0.1 staging env - copy to .env and fill before compose up.
# Everything else the PO sets in the ADMIN PANEL (/admin), not here.

# PostgreSQL password for the hiveos superuser (required)
HIVEOS_PG_PASSWORD=change-me-strong

# System admin panel credentials (required - used at /admin)
HIVEOS_SYSTEM_ADMIN_USERNAME=system-admin
HIVEOS_SYSTEM_ADMIN_PASSWORD=change-me-strong

# HTTP port nginx binds on the host
HIVEOS_HTTP_PORT=80

# Public origin(s) the browser app is served from, comma-separated. Must match
# the real host exactly or CORS silently blocks cross-origin clients (staging
# audit 2026-09-14, P1-8: the shipped value named staging.* while the live host
# was the apex domain, so only same-origin traffic worked).
HIVEOS_CORS_ORIGINS=https://hivesystem.ir

# Bootstrap provider mode (the panel decision overrides this at runtime)
HIVEOS_LLM_PROVIDER=mock
HIVEOS_SMS_PROVIDER=mock

# Welcome credit for new organizations
HIVEOS_WALLET_WELCOME_CREDIT=50

# Trusted reverse proxies for per-IP rate limiting. Comma-separated IPs/CIDRs.
#
# SECURITY (staging audit 2026-09-14, P1-7): this used to default to "*", which
# makes the limiter believe the leftmost X-Forwarded-For from ANY peer. Anything
# that can reach the API port could then rotate the header and bypass the limit
# entirely - measured: rotating XFF gave 200:40 / 429:0 against a 30/min limit.
# List the addresses nginx actually proxies from; do not use "*" in staging or
# production. The api port stays bound to 127.0.0.1:8100 behind nginx.
HIVEOS_TRUSTED_PROXIES=127.0.0.1
