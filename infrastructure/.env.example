# HiveOS infrastructure environment — template only.
# Copy to the *same directory* as docker-compose.yml before bringing the stack up:
#   cp infrastructure/.env.example infrastructure/.env
# (docker compose auto-loads `infrastructure/.env` as the project env file.)
#
# ── NO REAL SECRETS HERE ──────────────────────────────────────────────────
# These are dev placeholder values, NOT production credentials. `infrastructure/.env`
# is already gitignored (.gitignore: ".env" / ".env.*"), so your real values are
# never committed. Rotate POSTGRES_PASSWORD before any non-local deployment.

# Postgres (HiveOS instance; host port 5434, pgvector image)
POSTGRES_DB=hiveos
POSTGRES_USER=hiveos
# CHANGE THIS — used by both the `db` service and the backup sidecar (PGPASSWORD).
POSTGRES_PASSWORD=dev-insecure-change-me
