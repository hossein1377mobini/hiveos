# HiveOS app env on SERVER (copy to /opt/hiveos/app/.env, chmod 600; ADR-022 - never committed).
# remote-deploy.sh regenerates this file each deploy: IMAGE_TAG + DATABASE_URL (password from
# /opt/hiveos/secrets/pg_password, host = "db" service DNS via external network hiveos_default).
# ENVIRONMENT may be preset in /etc/environment or passed inline.
IMAGE_TAG=dev-local
ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://hiveos:CHANGE_ME@db:5432/hiveos
