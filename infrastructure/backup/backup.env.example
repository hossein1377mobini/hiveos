# HiveOS backup/restore configuration (S1-16) — copy to your environment, never
# commit real values. Matches the defaults in backup.sh / restore.sh /
# retention.sh and the hiveos-db service in infrastructure/docker-compose.yml.

# --- connection (custom-format pg_dump over TCP) -----------------------------
PGHOST=localhost
PGPORT=5434
PGUSER=hiveos
PGDATABASE=hiveos
# Required for TCP auth. In production inject this from a secret manager or use
# ~/.pgpass; never commit the real password. The v0.1 dev stack uses 'hiveos'.
PGPASSWORD=hiveos

# --- backup output + retention -----------------------------------------------
BACKUP_DIR=/var/backups/hiveos
GZIP_LEVEL=6
RETENTION_DAYS=14      # keep every daily backup for 14 days
RETENTION_WEEKS=8      # then keep the first backup of each ISO week for 8 weeks
RETENTION_MONTHS=12    # then keep the first backup of each month for 12 months

# --- restore target (see restore.sh) -----------------------------------------
TARGET_DATABASE=hiveos_restore_verify
# FORCE=1 releases the non-empty-target safety guard.

# --- pgbackup sidecar scheduler (see docker-compose.yml) ---------------------
BACKUP_INTERVAL_SECONDS=86400   # nightly (once per day)
